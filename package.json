{
  "name": "time-tracker",
  "private": true,
  "description": "Track the time you spend on your projects, locally or on your own ATproto repository.",
  "homepage": "https://time-tracker.felixs.dev",
  "bugs": {
    "url": "https://github.com/trueberryless/time-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trueberryless/time-tracker.git"
  },
  "license": "MIT",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check:all": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "contrast:build": "node scripts/build-contrast.mjs app/assets/css/themes.css app/assets/css/contrast.css",
    "dev": "nuxt dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "postinstall": "nuxt prepare",
    "knip": "knip",
    "lexicons:build": "node scripts/build-lexicons.ts",
    "lexicons:plan": "pnpm lexicons:build && airspace lexicons publish --lexicons lexicons --identity \"$AUTHORITY_IDENTITY\" --authority space.time-tracker --dry-run",
    "lexicons:publish": "pnpm lexicons:build && airspace lexicons publish --lexicons lexicons --identity \"$AUTHORITY_IDENTITY\" --authority space.time-tracker",
    "lint": "oxlint",
    "preview": "HOST=127.0.0.1 nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.55.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "airspace": "^0.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.5",
    "knip": "^6.41.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=24.11.0"
  }
}
